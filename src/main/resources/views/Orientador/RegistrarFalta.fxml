<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane styleClass="main-container" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.Orientador.RegistrarFaltaController">
   <stylesheets>
      <String fx:value="/styles/Orientador/RegistrarFaltaStyle.css" />
   </stylesheets>
   <children>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <content>
            <VBox spacing="30">
               <padding>
                  <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
               </padding>
               <children>
                  <!-- Encabezado -->
                  <VBox spacing="10.0">
                     <children>
                        <Label styleClass="titulo-seccion" text="Registrar Falta Disciplinaria">
                           <font>
                              <Font name="Roboto Medium" size="32.0" />
                           </font>
                        </Label>
                        <Label styleClass="descripcion-seccion" text="Completa el formulario para registrar una nueva falta disciplinaria del estudiante." wrapText="true">
                           <font>
                              <Font name="Roboto Regular" size="14.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
      
                  <!-- Datos del Estudiante -->
                  <VBox spacing="15.0" styleClass="form-card">
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                     <children>
                        <Label styleClass="form-section-title" text="Seleccionar Estudiante">
                           <font>
                              <Font name="Roboto Medium" size="16.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtEstudiante" promptText="Escribe el nombre del estudiante" styleClass="form-control">
                           <contextMenu>
                              <ContextMenu />
                           </contextMenu>
                           <font>
                              <Font size="14.0" />
                           </font>
                        </TextField>
                        <!-- Información del Estudiante -->
                        <VBox spacing="10.0" styleClass="info-box">
                           <padding>
                              <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                           </padding>
                           <children>
                              <HBox spacing="30.0">
                                 <children>
                                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label styleClass="form-label" text="Identificación">
                                             <font>
                                                <Font name="System Bold" size="12.0" />
                                             </font>
                                          </Label>
                                          <Label fx:id="lbIdentificacion" styleClass="form-value" text="-">
                                             <font>
                                                <Font size="16.0" />
                                             </font>
                                          </Label>
                                       </children>
                                    </VBox>
                                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label styleClass="form-label" text="Grado">
                                             <font>
                                                <Font name="System Bold" size="12.0" />
                                             </font>
                                          </Label>
                                          <Label fx:id="lbGrado" styleClass="form-value" text="-">
                                             <font>
                                                <Font size="16.0" />
                                             </font>
                                          </Label>
                                       </children>
                                    </VBox>
                                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label styleClass="form-label" text="Faltas Previas">
                                             <font>
                                                <Font name="System Bold" size="12.0" />
                                             </font>
                                          </Label>
                                          <Label fx:id="lbFaltasPrevias" styleClass="form-value" text="0">
                                             <font>
                                                <Font size="16.0" />
                                             </font>
                                          </Label>
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </VBox>
      
                  <!-- Detalles de la Falta -->
                  <VBox spacing="15.0" styleClass="form-card">
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                     <children>
                        <Label styleClass="form-section-title" text="Detalles de la Falta">
                           <font>
                              <Font name="Roboto Medium" size="16.0" />
                           </font>
                        </Label>
                        <HBox spacing="20.0" VBox.vgrow="NEVER">
                           <children>
                              <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="form-label" text="Tipo de Falta *">
                                       <font>
                                          <Font name="System Regular" size="12.0" />
                                       </font>
                                    </Label>
                                    <ComboBox fx:id="comboFaltaTipo" prefHeight="45.0" promptText="Selecciona el tipo" styleClass="form-control" />
                                 </children>
                              </VBox>
                              <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="form-label" text="Caso *">
                                       <font>
                                          <Font name="System Regular" size="12.0" />
                                       </font>
                                    </Label>
                                    <ComboBox fx:id="comboCaso" prefHeight="45.0" promptText="Elige un caso" styleClass="form-control" />
                                 </children>
                              </VBox>
                              <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="form-label" text="Lugar del Suceso *">
                                       <font>
                                          <Font name="System Regular" size="12.0" />
                                       </font>
                                    </Label>
                                    <ComboBox fx:id="comboLugar" prefHeight="45.0" promptText="Selecciona el lugar" styleClass="form-control" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
      
                  <!-- Bloque de Docente (Condicional) -->
                  <VBox fx:id="hboxDocente" spacing="15.0" styleClass="form-card">
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                     <children>
                        <Label styleClass="form-section-title" text="Docente Presente (Aula de Clases)">
                           <font>
                              <Font name="Roboto Medium" size="16.0" />
                           </font>
                        </Label>
                        <VBox spacing="8.0">
                           <children>
                              <Label styleClass="form-label" text="Nombre del Docente *">
                                 <font>
                                    <Font name="System Regular" size="12.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="txtDocente" prefHeight="45.0" promptText="Escribe el nombre del docente" styleClass="form-control">
                                 <contextMenu>
                                    <ContextMenu />
                                 </contextMenu>
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </TextField>
                           </children>
                        </VBox>
                     </children>
                  </VBox>
      
                  <!-- Descargos y Acción Restaurativa -->
                  <VBox spacing="15.0" styleClass="form-card">
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                     <children>
                        <Label styleClass="form-section-title" text="Observaciones">
                           <font>
                              <Font name="Roboto Medium" size="16.0" />
                           </font>
                        </Label>
                        <VBox spacing="8.0">
                           <children>
                              <Label styleClass="form-label" text="Descargo del Estudiante">
                                 <font>
                                    <Font name="System Regular" size="12.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="txtDescargo" prefHeight="50.0" promptText="Opcional: Descargo del estudiante" styleClass="form-control">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </TextField>
                           </children>
                        </VBox>
                        <VBox spacing="8.0">
                           <children>
                              <Label styleClass="form-label" text="Acción Restaurativa">
                                 <font>
                                    <Font name="System Regular" size="12.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="txtAccionRestaurativa" prefHeight="50.0" promptText="Opcional: Acción restaurativa sugerida" styleClass="form-control">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </TextField>
                           </children>
                        </VBox>
                     </children>
                  </VBox>
      
                  <!-- Botones de Acción -->
                  <HBox alignment="CENTER_RIGHT" spacing="15.0" VBox.vgrow="NEVER">
                     <children>
                        <Button mnemonicParsing="false" onAction="#clickGuardar" prefHeight="50.0" prefWidth="180.0" styleClass="btn,btn-primary" text="Guardar Falta">
                           <font>
                              <Font name="Roboto Medium" size="15.0" />
                           </font>
                        </Button>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </children>
</AnchorPane>
