<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane styleClass="main-container" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.Orientador.ConsultasController">

    <stylesheets>
        <String fx:value="/styles/Orientador/RegistrarFaltaStyle.css" />
    </stylesheets>

    <children>
        <VBox spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>

            <children>
                <VBox spacing="8.0">
                    <children>
                        <Label styleClass="titulo-seccion" text="Consultas de Faltas">
                            <font>
                                <Font name="Roboto Medium" size="30.0" />
                            </font>
                        </Label>
                        <Label styleClass="descripcion-seccion" text="Busca por estudiante y aplica filtros por fecha, tipo de falta, caso y lugar." />
                    </children>
                </VBox>

                <VBox spacing="14.0" styleClass="form-card">
                    <padding>
                        <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                    </padding>

                    <children>
                        <Label styleClass="form-section-title" text="Filtros de Consulta" />

                        <HBox spacing="12.0">
                            <children>
                                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="form-label" text="Estudiante" />
                                        <TextField fx:id="txtEstudiante" promptText="Escribe el nombre del estudiante" styleClass="form-control">
                                            <contextMenu>
                                                <ContextMenu />
                                            </contextMenu>
                                        </TextField>
                                    </children>
                                </VBox>

                                <VBox spacing="6.0">
                                    <children>
                                        <Label styleClass="form-label" text="Desde" />
                                        <DatePicker fx:id="dateDesde" prefWidth="180.0" styleClass="form-control" />
                                    </children>
                                </VBox>

                                <VBox spacing="6.0">
                                    <children>
                                        <Label styleClass="form-label" text="Hasta" />
                                        <DatePicker fx:id="dateHasta" prefWidth="180.0" styleClass="form-control" />
                                    </children>
                                </VBox>

                                <VBox spacing="6.0">
                                    <children>
                                        <Label styleClass="form-label" text="Tipo de Falta" />
                                        <ComboBox fx:id="comboTipoFalta" prefWidth="150.0" promptText="Todos" styleClass="form-control" />
                                    </children>
                                </VBox>

                                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="form-label" text="Caso" />
                                        <ComboBox fx:id="comboCaso" promptText="Todos" styleClass="form-control" />
                                    </children>
                                </VBox>

                                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="form-label" text="Lugar de Suceso" />
                                        <ComboBox fx:id="comboLugar" promptText="Todos" styleClass="form-control" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <children>
                                <Button mnemonicParsing="false" onAction="#clickLimpiar" styleClass="btn,btn-secondary" text="Limpiar">
                                    <font>
                                        <Font name="Roboto Medium" size="14.0" />
                                    </font>
                                </Button>
                                <Button mnemonicParsing="false" onAction="#clickBuscar" styleClass="btn,btn-primary" text="Buscar">
                                    <font>
                                        <Font name="Roboto Medium" size="14.0" />
                                    </font>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <VBox spacing="10.0" styleClass="form-card" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                    </padding>

                    <children>
                        <Label styleClass="form-section-title" text="Resultados" />
                        <Label styleClass="descripcion-seccion" text="Haz click en una fila para ver los detalles completos de la falta" />
                        <TableView fx:id="tableResultados" styleClass="tabla-datos" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colFecha" prefWidth="130.0" text="Fecha" />
                                <TableColumn fx:id="colEstudiante" prefWidth="320.0" text="Estudiante" />
                                <TableColumn fx:id="colTipo" prefWidth="120.0" text="Tipo" />
                                <TableColumn fx:id="colCaso" prefWidth="280.0" text="Caso" />
                                <TableColumn fx:id="colLugar" prefWidth="220.0" text="Lugar" />
                            </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>



