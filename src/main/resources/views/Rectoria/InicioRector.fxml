<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane styleClass="main-container" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.Rectoria.InicioRectorController">

    <stylesheets>
        <String fx:value="/styles/Orientador/RegistrarFaltaStyle.css" />
    </stylesheets>

    <children>
        <VBox spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>

            <children>
                <!-- Encabezado de bienvenida -->
                <VBox spacing="8.0">
                    <children>
                        <Label styleClass="titulo-seccion" text="¡Bienvenido, Rector!">
                            <font>
                                <Font name="Roboto Medium" size="36.0" />
                            </font>
                        </Label>
                        <Label styleClass="descripcion-seccion" text="Panel de control institucional — Aquí puedes consultar el resumen de disciplina, revisar estadísticas y generar informes del plantel.">
                            <font>
                                <Font size="16.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <!-- Estadísticas generales — fila 1 -->
                <VBox spacing="15.0">
                    <children>
                        <Label styleClass="form-section-title" text="Resumen General">
                            <font>
                                <Font name="Roboto Medium" size="18.0" />
                            </font>
                        </Label>

                        <HBox spacing="20.0">
                            <children>
                                <!-- Tarjeta 1: Total de Faltas -->
                                <VBox styleClass="form-card" HBox.hgrow="ALWAYS">
                                    <padding>
                                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                    </padding>
                                    <spacing>10.0</spacing>
                                    <children>
                                        <Label styleClass="form-label" text="TOTAL DE FALTAS REGISTRADAS">
                                            <font>
                                                <Font name="Roboto Medium" size="12.0" />
                                            </font>
                                        </Label>
                                        <Label fx:id="lblTotalFaltas" styleClass="form-value" text="0">
                                            <font>
                                                <Font name="Roboto Medium" size="42.0" />
                                            </font>
                                        </Label>
                                        <Label styleClass="descripcion-seccion" text="Cantidad total de faltas en el sistema">
                                            <font>
                                                <Font size="12.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>

                                <!-- Tarjeta 2: Total Estudiantes -->
                                <VBox styleClass="form-card" HBox.hgrow="ALWAYS">
                                    <padding>
                                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                    </padding>
                                    <spacing>10.0</spacing>
                                    <children>
                                        <Label styleClass="form-label" text="ESTUDIANTES REGISTRADOS">
                                            <font>
                                                <Font name="Roboto Medium" size="12.0" />
                                            </font>
                                        </Label>
                                        <Label fx:id="lblTotalEstudiantes" styleClass="form-value" text="0">
                                            <font>
                                                <Font name="Roboto Medium" size="42.0" />
                                            </font>
                                        </Label>
                                        <Label styleClass="descripcion-seccion" text="Total de estudiantes en el sistema">
                                            <font>
                                                <Font size="12.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>

                                <!-- Tarjeta 3: Tipo de Falta Más Frecuente -->
                                <VBox styleClass="form-card" HBox.hgrow="ALWAYS">
                                    <padding>
                                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                    </padding>
                                    <spacing>10.0</spacing>
                                    <children>
                                        <Label styleClass="form-label" text="TIPO DE FALTA MÁS FRECUENTE">
                                            <font>
                                                <Font name="Roboto Medium" size="12.0" />
                                            </font>
                                        </Label>
                                        <Label fx:id="lblTipoFaltaMasFrecuente" styleClass="form-value" text="N/A">
                                            <font>
                                                <Font name="Roboto Medium" size="28.0" />
                                            </font>
                                        </Label>
                                        <Label styleClass="descripcion-seccion" text="Clasificación de falta con mayor incidencia">
                                            <font>
                                                <Font size="12.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <!-- Estadísticas — fila 2 -->
                        <HBox spacing="20.0">
                            <children>
                                <!-- Tarjeta 4: Caso Más Común -->
                                <VBox styleClass="form-card" HBox.hgrow="ALWAYS">
                                    <padding>
                                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                    </padding>
                                    <spacing>10.0</spacing>
                                    <children>
                                        <Label styleClass="form-label" text="CASO MÁS COMÚN">
                                            <font>
                                                <Font name="Roboto Medium" size="12.0" />
                                            </font>
                                        </Label>
                                        <Label fx:id="lblCasoMasComun" styleClass="form-value" text="N/A" wrapText="true">
                                            <font>
                                                <Font name="Roboto Medium" size="22.0" />
                                            </font>
                                        </Label>
                                        <Label styleClass="descripcion-seccion" text="Tipo de caso con mayor frecuencia">
                                            <font>
                                                <Font size="12.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>

                                <!-- Tarjeta 5: Lugar con Más Faltas -->
                                <VBox styleClass="form-card" HBox.hgrow="ALWAYS">
                                    <padding>
                                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                    </padding>
                                    <spacing>10.0</spacing>
                                    <children>
                                        <Label styleClass="form-label" text="LUGAR CON MÁS FALTAS">
                                            <font>
                                                <Font name="Roboto Medium" size="12.0" />
                                            </font>
                                        </Label>
                                        <Label fx:id="lblLugarMasFaltas" styleClass="form-value" text="N/A" wrapText="true">
                                            <font>
                                                <Font name="Roboto Medium" size="22.0" />
                                            </font>
                                        </Label>
                                        <Label styleClass="descripcion-seccion" text="Sitio donde ocurren más faltas">
                                            <font>
                                                <Font size="12.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>

                                <!-- Tarjeta 6: Estudiante con Más Faltas -->
                                <VBox styleClass="form-card" HBox.hgrow="ALWAYS">
                                    <padding>
                                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                    </padding>
                                    <spacing>10.0</spacing>
                                    <children>
                                        <Label styleClass="form-label" text="ESTUDIANTE CON MÁS FALTAS">
                                            <font>
                                                <Font name="Roboto Medium" size="12.0" />
                                            </font>
                                        </Label>
                                        <Label fx:id="lblEstudianteMasfaltas" styleClass="form-value" text="N/A" wrapText="true">
                                            <font>
                                                <Font name="Roboto Medium" size="18.0" />
                                            </font>
                                        </Label>
                                        <Label styleClass="descripcion-seccion" text="Nombre y cantidad total de faltas">
                                            <font>
                                                <Font size="12.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- Módulos disponibles -->
                <VBox spacing="15.0">
                    <children>
                        <Label styleClass="form-section-title" text="Módulos Disponibles">
                            <font>
                                <Font name="Roboto Medium" size="18.0" />
                            </font>
                        </Label>

                        <!-- Módulo Estadísticas -->
                        <VBox style="-fx-effect: null;" styleClass="form-card">
                            <padding>
                                <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                            </padding>
                            <spacing>10.0</spacing>
                            <children>
                                <Label text="📊 Estadísticas">
                                    <font>
                                        <Font size="20.0" />
                                    </font>
                                    <style>-fx-text-fill: #0d5f8e;</style>
                                </Label>
                                <Label text="Visualización gráfica de los datos disciplinarios del plantel. Permite analizar faltas por tipo, caso, lugar, grado, género y mes. Incluye comparativa histórica por caso para identificar tendencias y patrones de comportamiento a lo largo del tiempo." wrapText="true">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                    <style>-fx-text-fill: #495057;</style>
                                </Label>
                            </children>
                        </VBox>

                        <!-- Módulo Informes -->
                        <VBox style="-fx-effect: null;" styleClass="form-card">
                            <padding>
                                <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                            </padding>
                            <spacing>10.0</spacing>
                            <children>
                                <Label text="📄 Informes">
                                    <font>
                                        <Font size="20.0" />
                                    </font>
                                    <style>-fx-text-fill: #0d5f8e;</style>
                                </Label>
                                <Label text="Generación de informes en formato PDF. Permite exportar el historial de faltas de un estudiante específico o un informe general de todas las faltas registradas, con filtros por fecha. Los documentos quedan guardados en la carpeta de reportes del sistema." wrapText="true">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                    <style>-fx-text-fill: #495057;</style>
                                </Label>
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <!-- Pie de página -->
                <VBox spacing="8.0">
                    <children>
                        <Label styleClass="descripcion-seccion" text="Sistema de Gestión de Disciplina - Constructores de Paz">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                        <Label styleClass="descripcion-seccion" text="Para más información o reportar problemas, contacta al administrador del sistema.">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

            </children>
        </VBox>
    </children>
</AnchorPane>
